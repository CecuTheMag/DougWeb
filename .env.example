# Doug marketing site — environment variables.
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# Canonical origin, no trailing slash. Used for canonical URLs, OG images,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://answeredbydoug.com

# --- Early-access storage (Upstash Redis / Vercel KV) -----------------------
# Adding the Upstash integration from the Vercel Marketplace sets the KV_*
# names automatically. The UPSTASH_REDIS_REST_* names work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Early-access email notification (Resend) --------------------------------
RESEND_API_KEY=
# Where new requests are sent. Comma-separate several addresses.
EARLY_ACCESS_NOTIFY_TO=you@example.com
# Must be on a domain you have verified in Resend.
EARLY_ACCESS_FROM="Doug <early-access@answeredbydoug.com>"

# Behaviour when unset:
#  - Neither KV nor Resend configured, in development: requests are logged to
#    the console and the form succeeds (for local work only).
#  - Neither configured, in production: the API returns 503 and the form asks
#    the visitor to try again. It never shows success for a request that
#    wasn't saved.
#  - Either one configured: the request succeeds if that one worked.
